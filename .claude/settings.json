{
  "permissions": {
    "allow": [
      "Bash(.claude/tools/graph.sh:*)",
      "Bash(.claude/tools/tree.sh:*)",
      "Bash(graphify:*)",
      "Bash(uv tool install graphifyy)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__get_diagnostics_for_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/tools/serena-hook.sh remind"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/tools/serena-hook.sh cleanup"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "env": {
    "MCP_TIMEOUT": "120000"
  }
}
