{
  "permissions": {
    "allow": [
      "Bash(.claude/tools/graph.sh:*)",
      "Bash(.claude/tools/tree.sh:*)",
      "Bash(.claude/skills/code-nav/check.sh)",
      "Bash(graphify:*)",
      "Bash(uv tool install graphifyy)",
      "mcp__serena",
      "Bash(npm test)",
      "Bash(npm run test:api)",
      "Bash(npm run test:browser)",
      "Bash(npm run test:store)",
      "Bash(npm ci)",
      "Bash(node scripts/build.js:*)",
      "Bash(node scripts/seo-test.js)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/tools/serena-hook.sh remind"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/tools/serena-hook.sh cleanup"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "env": {
    "MCP_TIMEOUT": "120000"
  }
}
