# Cloudflare Pages response headers. The pages.dev copies of the site (the project address and every preview deployment)
# stay out of search results, so https://autostacc.com is the only address search engines index.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Every page: HTTPS only (browsers remember it for a year), no framing by other sites (clickjacking), no MIME
# sniffing, no full URLs leaked to other sites, no camera/microphone/location, and a baseline content policy (no
# plugins, no <base> hijacking, no framing elsewhere), plus the page-preloading rules (speculation-rules.json). Public
# pages embed music players from several services, so they don't restrict scripts further; account and store pages
# below add a strict policy (docs/production.md).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  Speculation-Rules: "/speculation-rules.json"

# The preloading rules every page points at (above): browsers that support them load a same-origin page as a visitor
# hovers or presses its link, so page changes are near instant. A file, not an inline script, so no policy is loosened.
/speculation-rules.json
  Content-Type: application/speculationrules+json
  Cache-Control: no-cache

# Plain addresses of scripts, styles and data (pages use fingerprinted /assets/ copies; these serve what loads files by
# name) keep the same URL across deploys, so browsers re-check them on every visit (a quick "not modified"). Without this a phone can keep old files for hours and show a mix of versions.
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache

# Fingerprinted copies made by scripts/dist.js: the address changes whenever the content does, so keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names when replaced, so browsers keep them for a day, not forever.
/img/*
  Cache-Control: public, max-age=86400

# Account and store pages: only this site's own scripts may run, and they may only talk to this site.
/cart
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'
