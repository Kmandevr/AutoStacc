# Cloudflare Pages redirects. The home page is index.html at /; Pages itself sends /index and /*.html to the clean address.
# When a public page is removed or renamed, add a 301 here from its old address (scripts/seo-test.js checks this).
/home       /  301
/home.html  /  301
# 2026-10-08: the site became AutoStacc and Glitches & Stitches moved under its project, then into its creator's
# space at /autostacc/glitches-and-stitches (docs/decisions.md). Each old address goes straight to the current one, no chains.
# 2026-10-21: news is offline until each creator's community opens (#174): the content Function sends a project's
# /news addresses to its home, so the old news addresses go straight there too. The first matching rule wins.
/music      /autostacc/glitches-and-stitches/music  301
/music/*    /autostacc/glitches-and-stitches/music/:splat  301
/news       /autostacc/glitches-and-stitches  301
/news/*     /autostacc/glitches-and-stitches  301
/press      /autostacc/glitches-and-stitches/press  301
/music.html /autostacc/glitches-and-stitches/music  301
/news.html  /autostacc/glitches-and-stitches  301
/press.html /autostacc/glitches-and-stitches/press  301
/projects/glitches-and-stitches    /autostacc/glitches-and-stitches  301
/projects/glitches-and-stitches/news    /autostacc/glitches-and-stitches  301
/projects/glitches-and-stitches/news/*  /autostacc/glitches-and-stitches  301
/projects/glitches-and-stitches/*  /autostacc/glitches-and-stitches/:splat  301
# Projects and Creators became Discover's tabs (owner, 2026-10-22, #208).
/projects   /discover?tab=projects  301
/creators   /discover?tab=creators  301
# 2026-10-08: Account and Settings became one Settings area with a page per section (docs/decisions.md).
/account    /settings/orders  301
# Settings sections (/settings/security, ...) are one page. With the store on, functions/settings/[[path]].js gates and
# serves them (Cloudflare doesn't apply this file to an address a Function answers); with it off, this serves the page.
/settings/profile  /settings  200
/settings/security  /settings  200
/settings/orders  /settings  200
/settings/email  /settings  200
/settings/privacy  /settings  200
# The Control Center's sub-pages (/admin/stats, ...) are one page too: functions/admin/[[path]].js gates and serves
# them with the store on; with it off, this serves the page (which then says it can't check access).
/admin/stats  /admin  200
/admin/daily  /admin  200
/admin/manage  /admin  200
/admin/settings  /admin  200
